# Copy thành .env.local và điền giá trị từ Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Đẩy thông báo ra ngoài app (Web Push). Chỉ cần nửa CÔNG KHAI của cặp khoá VAPID ở
# đây — nửa riêng tư là secret của edge function push-notify, đừng đặt vào file này
# vì mọi VITE_* đều bị nhúng vào bundle mà ai cũng tải được.
# Cách sinh cặp khoá: xem docs/push-notification.md
# Để trống thì app vẫn chạy, chỉ là công tắc đẩy thông báo hiện "chưa cấu hình".
VITE_VAPID_PUBLIC_KEY=
