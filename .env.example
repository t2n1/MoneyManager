# Copy thành .env.local và điền giá trị từ Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Đẩy thông báo ra ngoài app (Web Push). Chỉ cần nửa CÔNG KHAI của cặp khoá VAPID ở
# đây — nửa riêng tư là secret của edge function push-notify, đừng đặt vào file này
# vì mọi VITE_* đều bị nhúng vào bundle mà ai cũng tải được.
# Cách sinh cặp khoá: xem docs/push-notification.md
# Để trống thì app vẫn chạy, chỉ là công tắc đẩy thông báo hiện "chưa cấu hình".
VITE_VAPID_PUBLIC_KEY=

# MCP server cho Claude (chỉ cần trên MÁY chạy Claude Code, không phải cho web app).
# Hai giá trị này KHÔNG đọc từ file này — chúng phải là biến môi trường của người dùng,
# vì .mcp.json nằm trong git và token là hàng rào duy nhất của server đó.
# Windows: setx SO_GAO_MCP_URL "https://<ten-app>.vercel.app/api/mcp"
#          setx MCP_BEARER_TOKEN "<token>"     rồi mở lại terminal.
# Token sinh bằng: openssl rand -hex 32
